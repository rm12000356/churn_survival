# Runtime
LOG_LEVEL=INFO
REFERENCE_DATE=2026-08-15

# LLM (provider-agnostic)
LLM_PROVIDER=anthropic        # anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=

# Paths
MODEL_DIR=models/
RAW_DATA_DIR=data/raw/
PROCESSED_DATA_DIR=data/processed/
CONFIG_DIR=config/

# Pipeline behavior
DEFAULT_LOOKBACK_DAYS=365
MAX_THREADS_PER_CUSTOMER=50
MAX_MESSAGES_PER_THREAD=100

# Node 3 external sources (multi-source ingestion)
# Mock mode is the default and requires no credentials. Secrets are placeholders
# only; never commit real tokens. Live mode fails loudly if a source is enabled
# without its credentials.
NODE3_SOURCE_MODE=mock
NODE3_MOCK_SOURCES_DIR=mock_sources/

# X (public posts/mentions and, when authorized, DMs)
X_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=

# Gmail (OAuth2; refresh token issued out of band)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=