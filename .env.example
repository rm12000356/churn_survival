# Runtime
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | console
REFERENCE_DATE=2026-08-15

# LLM (provider-agnostic)
LLM_PROVIDER=anthropic        # anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=

# Paths
MODEL_DIR=models/
RAW_DATA_DIR=data/raw/
PROCESSED_DATA_DIR=data/processed/
CONFIG_DIR=config/
RUN_DIR=runs/
# Horizon static frontend. Mounted at "/" only when the directory exists.
FRONTEND_DIR=frontend/

# Pipeline behavior
DEFAULT_LOOKBACK_DAYS=365
MAX_THREADS_PER_CUSTOMER=50
MAX_MESSAGES_PER_THREAD=100

# Retention / GC (Phase 8). 0 disables a limit. TTL applies only to pending
# (STOPPED_NEEDS_MAPPING/INTERRUPTED) run states and unconfirmed mapping drafts.
MODEL_RETENTION_MAX=0
RUN_RETENTION_MAX=0
PENDING_RUN_TTL_DAYS=7
GC_ON_STARTUP=false

# Phase 8 API. Reads are open by default; writes are disabled and require a key.
# Enabling API_ENABLE_WRITES without API_KEY is a startup error.
API_KEY=
API_KEY_HEADER=X-API-Key
# true = reads need the key too (default: reads open, key gates writes only).
API_REQUIRE_KEY_FOR_READS=false
API_ENABLE_WRITES=false
API_ALLOW_ARBITRARY_PATHS=false
API_HOST=127.0.0.1
API_PORT=8000
RUN_MAX_WORKERS=2
# Optional LLM worker overrides (unset = versioned config: Node 3 = 8, Node 5 = 4).
# Raise if your provider's rate limit allows; output is identical at any value.
# NODE3_LLM_MAX_CONCURRENCY=16
# NODE5_LLM_MAX_CONCURRENCY=8

# Node 3 external sources (multi-source ingestion)
# Mock mode is the default and requires no credentials. Secrets are placeholders
# only; never commit real tokens. Live mode fails loudly if a source is enabled
# without its credentials.
NODE3_SOURCE_MODE=mock
NODE3_MOCK_SOURCES_DIR=mock_sources/

# X (public posts/mentions and, when authorized, DMs)
X_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=

# Gmail (OAuth2; refresh token issued out of band)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=